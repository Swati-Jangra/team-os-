{
  "name": "team-os-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=200",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @teamos/database generate",
    "db:migrate": "pnpm --filter @teamos/database migrate",
    "db:seed": "pnpm --filter @teamos/database seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^1.20.9",
      "qs": "^6.16.1",
      "multer": "^2.5.0",
      "postcss": "^8.5.23"
    }
  }
}
