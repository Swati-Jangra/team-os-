# Copy to .env and fill in. Never commit real credentials.

# --- Database / cache ---
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/teamos?schema=public"
DIRECT_URL="postgresql://migrator:migrator_password@localhost:5432/teamos?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth / URLs ---
AUTH_SECRET="replace-with-32+-char-random-string"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# --- AI providers (used from Phase 4) ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Integrations (used from Phase 6) ---
# 32 random bytes, base64 (generate: openssl rand -base64 32). Encrypts stored OAuth tokens and webhook secrets. Never commit a real value.
INTEGRATION_ENCRYPTION_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Only change these to point at GitHub Enterprise or a test double.
GITHUB_API_URL="https://api.github.com"
GITHUB_OAUTH_URL="https://github.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Endpoints (defaults are Google's; override only for testing against a mock)
GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL="https://oauth2.googleapis.com/token"
GOOGLE_REVOKE_URL="https://oauth2.googleapis.com/revoke"
GOOGLE_CALENDAR_API_URL="https://www.googleapis.com/calendar/v3"
GMAIL_API_URL="https://gmail.googleapis.com/gmail/v1"
# INTEGRATION_ENCRYPTION_KEY (above) also encrypts Google tokens. Generate your own; never commit it.

# --- Object storage (S3 / R2 / MinIO) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="teamos"

# --- Email (dev: Mailpit) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="TeamOS AI <no-reply@teamos.local>"

# --- Observability ---
SENTRY_DSN=""

# AI provider: "local" (offline, dev only) or "openai"
AI_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=
# OPENAI_EMBEDDING_MODEL=

# Where uploaded meeting audio is stored (API and worker must share this directory)
STORAGE_DIR=./storage
