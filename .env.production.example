# Copy to .env.production and fill in. NEVER commit the filled-in file.
# Generate secrets with:  openssl rand -base64 48   (AUTH_SECRET)   openssl rand -base64 32   (INTEGRATION_ENCRYPTION_KEY)
#                         openssl rand -hex 24      (passwords, METRICS_TOKEN)

DOMAIN=app.example.com

# --- database / cache (passwords are only read at first start of the bundled containers) ---
POSTGRES_DB=teamos
POSTGRES_ADMIN_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- app ---
AUTH_SECRET=
METRICS_TOKEN=
# 32 random bytes, base64. Encrypts third-party OAuth tokens. Losing it means every integration must be reconnected.
INTEGRATION_ENCRYPTION_KEY=

# --- mail (invitations, password reset, notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 'true' = implicit TLS (465). Leave empty for STARTTLS on 587 (required in production).
SMTP_SECURE=
MAIL_FROM="TeamOS AI <no-reply@example.com>"

# --- AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=

# --- optional integrations (leave empty to disable) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
